[sub_resource type="GDScript" id="GDScript_lgwhq"]
script/source = "extends Area2D
@onready var player: Player = $\"../../Player\"

var player_count : Array = []
@onready var pc_2: PointLight2D = $\"../../light/pclight/pc2\"
var already_played : bool = false

func _ready() -> void:
	pc_2.enabled = Boolvariable.doc_room_pc2
	await get_tree().process_frame
	if !Boolvariable.doc_room_pc2:
		already_played = true
	body_entered.connect(player_in)
	body_exited.connect(player_out)
	Global.puzzle2_done.connect(puzzle_done)

func player_in(body):
	if body is Player:
		player_count.append(body)
		Global.interactable_arr.append(body)
func player_out(body):
	if body is Player:
		player_count.pop_front()
		Global.interactable_arr.pop_back()
		
func _input(event: InputEvent) -> void:
	if event and player_count.size() > 0:
		if event.is_action_pressed(\"interact\"):
			if !already_played:
				play_game()
			else:
				Boolvariable.doc_room_pc2 = !Boolvariable.doc_room_pc2
				await get_tree().process_frame
				pc_2.enabled = Boolvariable.doc_room_pc2
			
			
func puzzle_done():
	already_played = true
	Boolvariable.doc_room_pc2 = !Boolvariable.doc_room_pc2
	await get_tree().process_frame
	pc_2.enabled = Boolvariable.doc_room_pc2
	$\"../../puzzle\".get_child(0).queue_free()
	player.player_able_to_move = true

func play_game():
	player.player_able_to_move = false
	var scene = preload(\"res://TSCN/puzzle/control.tscn\")
	var inst = scene.instantiate()
	$\"../../puzzle\".add_child(inst)
	
"


[sub_resource type="GDScript" id="GDScript_oogmt"]
script/source = "extends Area2D

var player_count : Array = []
@onready var pc_3: PointLight2D = $\"../../light/pclight/pc3\"

func _ready() -> void:
	pc_3.enabled = Boolvariable.doc_room_pc3
	body_entered.connect(player_in)
	body_exited.connect(player_out)

func player_in(body):
	if body is Player:
		player_count.append(body)
		Global.interactable_arr.append(body)
func player_out(body):
	if body is Player:
		player_count.pop_front()
		Global.interactable_arr.pop_back()
		
func _input(event: InputEvent) -> void:
	if event and player_count.size() > 0:
		if event.is_action_pressed(\"interact\"):
			Boolvariable.doc_room_pc3 = !Boolvariable.doc_room_pc3
			await get_tree().process_frame
			pc_3.enabled = Boolvariable.doc_room_pc3
"

[sub_resource type="GDScript" id="GDScript_x4t3a"]
script/source = "extends Area2D
@onready var main_light: PointLight2D = $\"../../light/mainLight\"

var player_count : Array = []

func _ready() -> void:
	main_light.enabled = Boolvariable.doc_room_light
	body_entered.connect(player_in)
	body_exited.connect(player_out)

func player_in(body):
	if body is Player:
		player_count.append(body)
		Global.interactable_arr.append(body)
func player_out(body):
	if body is Player:
		player_count.pop_front()
		Global.interactable_arr.pop_back()
		
func _input(event: InputEvent) -> void:
	if event and player_count.size() > 0:
		if event.is_action_pressed(\"interact\"):
			Boolvariable.doc_room_light = !Boolvariable.doc_room_light
			await get_tree().process_frame
			main_light.enabled = Boolvariable.doc_room_light
			Boolvariable.update_sanity()
"

